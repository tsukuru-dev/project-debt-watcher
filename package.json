{
  "name": "debt-watcher",
  "version": "1.0.0",
  "license": "BSD-3-Clause",
  "description": "Find ageing code comments and stale Git branches across a repository.",
  "keywords": ["technical-debt", "git", "todo", "code-comments", "cli"],
  "homepage": "https://github.com/tsukuru-dev/project-debt-watcher#readme",
  "bugs": "https://github.com/tsukuru-dev/project-debt-watcher/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsukuru-dev/project-debt-watcher.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test",
    "debt-watcher": "node dist/cli.js",
    "prepack": "npm run build"
  },
  "bin": {
    "debt-watcher": "dist/cli.js"
  },
  "files": [
    "dist/",
    "templates/"
  ],
  "dependencies": {
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2"
  }
}
