{
  "name": "debt-watcher",
  "version": "0.0.0",
  "description": "Your friendly neighbourhood project debt watcher.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
